# ==============================================================================
# SafeVision AI — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the .env file — it contains secrets.
# ==============================================================================

# --- Application ---
APP_NAME=SafeVision AI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://safevision:safevision_dev@localhost:5432/safevision_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT / Auth ---
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Rate Limiting ---
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_DEFAULT=60/minute

# --- Evidence Storage ---
# Backend: "local" or "s3" (swappable, defaults to local)
EVIDENCE_STORAGE_BACKEND=local
EVIDENCE_LOCAL_PATH=./evidence_storage
# S3 config (only needed if EVIDENCE_STORAGE_BACKEND=s3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_S3_REGION=

# --- Email Notifications ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=alerts@safevision.ai

# --- WhatsApp Notifications (Twilio) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=

# --- AI/RAG (Phase 21) ---
# LLM_API_URL=
# LLM_API_KEY=
# LLM_MODEL=

# --- CV Models (paths to trained weights) ---
CV_PPE_MODEL_PATH=../models/ppe/best.pt
CV_FIRE_SMOKE_MODEL_PATH=../models/fire_smoke/best.pt
